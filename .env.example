# Copy to .env and uncomment what you want to change: cp .env.example .env
# Then run ./run.sh - it rebuilds/recreates only what changed (login and settings are kept).
# Values shown are the defaults.

# --- Versions (rebuild the image) ---
# ZCODE_VERSION=3.14.4
# NODE_VERSION=24              # Node major for node/npm/npx/corepack

# --- Resources ---
# ZCODE_CPUS=4                 # CPU ceiling for the container (cores, fractions ok: 2.5)

# --- Stream performance (browser mode; see PERF.md) ---
# ZCODE_FPS=30                 # initial fps; "30,8-60" also sets the sidebar range, "30-30" locks it
# ZCODE_ENCODER=jpeg,h264enc-striped,h264enc   # first = default, list = sidebar choices, single value locks
# ZCODE_JPEG_QUALITY=70        # JPEG quality while content moves (1-100; Selkies default 40); "70,1-100" also sets the sidebar range
# ZCODE_TURBO=false            # true = encode every frame (smoother motion, much more CPU)
# ZCODE_SCALE_1X=true          # false = full Retina resolution (sharper text, ~4x the pixels)
# ZCODE_WIDTH=0                # >0 locks the desktop size (with ZCODE_HEIGHT); 0 = follow the browser window
# ZCODE_HEIGHT=0
# ZCODE_AUDIO=false            # stream sound to the browser
# ZCODE_REDUCED_MOTION=1       # 0 = keep ZCode's UI animations

# --- OpenAI-compatible API (browser mode; https://zcode.orb.local/api/v1, see README "API") ---
# ZCODE_API=1                  # 0 = don't run the API service
# ZCODE_API_KEY=               # require "Authorization: Bearer <key>" (recommended: other containers can reach it)
# ZCODE_API_ORIGINS=           # browser origins allowed to call it (CORS), comma-separated; empty = no browser pages
# ZCODE_API_AGENT=0            # 1 = callers may pass zcode.cwd/mode/tools to run the full agent (see SECURITY.md #12)
# ZCODE_API_MODEL=GLM-5.3-Flash   # model when a request names none
# ZCODE_API_REASONING=high        # reasoning when a request sends no reasoning_effort: low, medium, high, xhigh, max
# ZCODE_API_PROVIDER=account:zai-individual-coding-plan   # ZCode provider for bare model names (team plan: account:zai-team-coding-plan)
# ZCODE_API_CONCURRENCY=2      # CLI runs at once; more requests queue
# ZCODE_API_TIMEOUT=600        # seconds before a run is killed

# --- Runtime ---
# ZCODE_RUNTIME=               # auto-detected; orbstack | docker (plain Docker: untested, see README)
# ZCODE_PORT=3000              # plain Docker only: desktop + API on http://localhost:<port> (loopback only)
# ZCODE_CDP_PORT=9223          # plain Docker only: DevTools proxy port (loopback only)

# --- Your own variables inside the container ---
# Not here: .env only configures this project. For variables the agent's shell and tools should see
# (API keys, HTTP_PROXY, ...), create container.env (git-ignored) with plain KEY=value lines:
#   echo 'MY_TOKEN=abc123' >> container.env     # then ./run.sh

# --- Misc ---
# ZCODE_CDP=0                  # 1 = DevTools Protocol on zcode.orb.local:9223 (see SECURITY.md #8)
# ZCODE_FLAGS=                 # extra Electron/Chromium flags
# TZ=Etc/UTC
